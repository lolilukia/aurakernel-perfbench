{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "AuraKernel PerfBench",
    "version": "2.0.0",
    "theme": "terminal-dark-primary",
    "note": "Dark IDE and terminal instrument; display, labels and data use a compact mono rhythm."
  },
  "color": {
    "terminal": {
      "background": "#070A0E",
      "surface": "#0D1218",
      "surfaceSubtle": "#101821",
      "border": "#1D2A34",
      "borderStrong": "#30424F",
      "textPrimary": "#DBE7EE",
      "textMuted": "#8295A4",
      "textFaint": "#52636F",
      "compute": "#67E8D2",
      "computeBright": "#8FF7E5",
      "cost": "#FFB86C",
      "danger": "#FF6680",
      "focus": "#6CBFFF"
    },
    "deepTerminal": {
      "background": "#05080C",
      "surface": "#090E13",
      "surfaceSubtle": "#0D141B",
      "border": "#18242E",
      "borderStrong": "#2A3A46",
      "textPrimary": "#E6EDF3",
      "textMuted": "#718593",
      "textFaint": "#52636F",
      "compute": "#79F7DE",
      "computeBright": "#A2FFE9",
      "cost": "#FFC47F",
      "danger": "#FF7890",
      "focus": "#7CC6FF"
    },
    "syntax": {
      "keyword": "#CBA6FF",
      "type": "#6CBFFF",
      "string": "#FFB86C",
      "number": "#F6D76B",
      "comment": "#60717F"
    },
    "ramp": {
      "sequentialGoodToBad": ["#164B45", "#1D4544", "#27343E", "#4A3540", "#5A2D38"],
      "sequentialBadToGood": ["#5A2D38", "#4A3540", "#27343E", "#1D4544", "#164B45"],
      "diverging": ["#FF6680", "#5A2D38", "#27343E", "#164B45", "#67E8D2"],
      "utilization": ["#24333D", "#315064", "#416D7F", "#4D5F90", "#715A9A"]
    },
    "model": {
      "gpt-5-6-sol": "#67E8D2",
      "claude-opus-4-8": "#FFB86C",
      "gemini-3-1-pro": "#6CBFFF",
      "deepseek-v4-pro": "#CBA6FF",
      "qwen3-7-max": "#F6D76B",
      "glm-5-2": "#7DD3FC",
      "kimi-k2-7": "#FF79A8"
    }
  },
  "typography": {
    "displayFamily": "JetBrains Mono, SFMono-Regular, Consolas, monospace",
    "bodyFamily": "Inter, Geist, ui-sans-serif, system-ui, sans-serif",
    "monoFamily": "JetBrains Mono, SFMono-Regular, Consolas, Liberation Mono, monospace",
    "scale": {
      "display": { "sizePx": 64, "sizeRem": 4, "weight": 720, "lineHeight": 1.02 },
      "h1": { "sizePx": 40, "sizeRem": 2.5, "weight": 670, "lineHeight": 1.1 },
      "h2": { "sizePx": 28, "sizeRem": 1.75, "weight": 650, "lineHeight": 1.2 },
      "h3": { "sizePx": 18, "sizeRem": 1.125, "weight": 650, "lineHeight": 1.3 },
      "body": { "sizePx": 15, "sizeRem": 0.9375, "weight": 420, "lineHeight": 1.65 },
      "label": { "sizePx": 12, "sizeRem": 0.75, "weight": 620, "lineHeight": 1.35 },
      "data": { "sizePx": 13, "sizeRem": 0.8125, "weight": 520, "lineHeight": 1.4 },
      "micro": { "sizePx": 10, "sizeRem": 0.625, "weight": 620, "lineHeight": 1.3 }
    }
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96 },
  "radius": { "xs": 2, "sm": 3, "md": 4, "lg": 6, "pill": 999 },
  "shadow": {
    "none": "none",
    "floating": "0 24px 80px rgba(0,0,0,.58)",
    "tooltip": "0 18px 46px rgba(0,0,0,.55)"
  },
  "motion": {
    "fast": "150ms cubic-bezier(.2,.8,.2,1)",
    "standard": "220ms cubic-bezier(.2,.8,.2,1)",
    "slow": "400ms cubic-bezier(.2,.8,.2,1)"
  },
  "breakpoint": { "mobile": 390, "tablet": 834, "desktop": 1440, "contentMax": 1240 }
}
